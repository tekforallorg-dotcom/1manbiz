# 1Man.Biz environment variables
# Copy this to apps/web/.env.local for the Next.js app.
# Mobile app uses apps/mobile/.env (different file).

# --- Supabase ---
# Public client credentials (safe to ship to browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key. SERVER-ONLY. Bypasses RLS.
# Used by the WhatsApp webhook handler to write to DB on Meta's behalf.
# Get from: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- WhatsApp Cloud API (Meta) ---
# The string Meta sends with hub.verify_token during webhook verification.
# Must match what you configure in the Meta App > Webhooks > Verify Token field.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_secret_here

# App Secret from the Meta App dashboard. Used to verify the HMAC-SHA256
# signature on every incoming webhook POST. When unset, signature checking
# is skipped (dev only, with warning logs).
WHATSAPP_APP_SECRET=your_meta_app_secret_here
