# Hoist every transitive dep to the workspace root's node_modules so
# Metro bundler and expo-cli (running in apps/mobile/) can resolve all
# of Expo's transitive peers via standard Node module resolution.
#
# This setting keeps pnpm's default isolated linker, which is critical
# for Vercel CI: apps/web/node_modules/next/ remains a proper symlink
# with working bin shims. Without isolated linker, Vercel cannot find
# next at the path the bin shim hardcodes.
#
# Do not switch back to node-linker=hoisted: it breaks Vercel by
# eliminating per-workspace node_modules entirely. See CLAUDE.md
# deviation entry 13 for the deploy that failed because of this.
shamefully-hoist=true
